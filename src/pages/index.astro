</style>

<script>
  const burger = document.querySelector('.nav__burger') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLDivElement;
  const closeBtn = menu?.querySelector('.mobile-menu__close') as HTMLButtonElement;

  function openMenu() {
    menu.removeAttribute('hidden');
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    menu.setAttribute('hidden', '');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  burger?.addEventListener('click', () => {
    if (menu.hasAttribute('hidden')) openMenu(); else closeMenu();
  });
  closeBtn?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  const form = document.querySelector('.contact-form');
  form?.addEventListener('submit', (e) => {
    let valid = true;
    form.querySelectorAll('input, textarea').forEach(el => {
      const errorEl = el.parentElement?.querySelector('.field-error');
      let msg = '';
      if (el.validity.valueMissing) {
        msg = 'Este campo es obligatorio.';
      } else if (el.validity.typeMismatch) {
        msg = 'Ingresá un correo electrónico válido.';
      } else if (el.validity.patternMismatch) {
        msg = 'El nombre no puede ser solo números.';
      }
      const iconSvg = `<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="6" cy="6" r="5.5" stroke="#c0392b"/><path d="M6 5v4" stroke="#c0392b" stroke-linecap="round"/><circle cx="6" cy="3.5" r="0.5" fill="#c0392b"/></svg>`;
      if (msg) {
        valid = false;
        el.classList.add('invalid');
        if (errorEl) { errorEl.innerHTML = iconSvg + msg; errorEl.hidden = false; }
      } else {
        el.classList.remove('invalid');
        if (errorEl) { errorEl.hidden = true; }
      }
    });
    if (!valid) e.preventDefault();
  });
  form?.querySelectorAll('input, textarea').forEach(el => {
    el.addEventListener('input', () => {
      const errorEl = el.parentElement?.querySelector('.field-error');
      if (el.validity.valid) {
        el.classList.remove('invalid');
        if (errorEl) errorEl.hidden = true;
      }
    });
  });

  document.querySelector('.btn-copy')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText('ProfeJulioPereyra');
    const label = document.querySelector('.copy-feedback');
    if (label) label.hidden = false;
  });
</script>
