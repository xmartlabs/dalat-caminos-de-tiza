---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Caminos de Tiza – Educación comunitaria, gratuita y solidaria</title>
  <meta name="description" content="Trabajamos junto a niños, adolescentes y familias en situaciones de vulnerabilidad en Argentina, llevando educación, inclusión y dignidad a quienes más lo necesitan." />
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
</head>

<body>

  <!-- NAV -->
  <header class="nav">
    <a href="/" class="nav__logo" aria-label="Caminos de Tiza">
      <img src="/assets/logo.svg" alt="Caminos de Tiza" height="42" />
    </a>
    <nav class="nav__links" aria-label="Navegación principal">
      <a href="#quienes-somos">Quiénes somos</a>
      <a href="#que-hacemos">Qué hacemos</a>
      <a href="#con-quienes">Con quiénes trabajamos</a>
      <a href="#impacto">Impacto</a>
      <a href="#colaborar" class="btn-nav">Colaborar</a>
    </nav>
    <button class="nav__burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <a href="#quienes-somos">Quiénes somos</a>
    <a href="#que-hacemos">Qué hacemos</a>
    <a href="#con-quienes">Con quiénes trabajamos</a>
    <a href="#impacto">Impacto</a>
    <a href="#colaborar" class="btn-primary">Colaborar</a>
  </div>

  <!-- HERO -->
  <section class="hero" id="inicio">
    <div class="hero__bg" aria-hidden="true">
      <img src="/assets/hero-bg.png" alt="" />
    </div>
    <div class="hero__content">
      <p class="accent">Educación comunitaria, gratuita y solidaria</p>
      <h1>Caminos que transforman vidas</h1>
      <p class="hero__body">Trabajamos junto a niños, adolescentes y familias en situaciones de vulnerabilidad en Argentina, llevando educación, inclusión y dignidad a quienes más lo necesitan.</p>
      <div class="hero__actions">
        <a href="#colaborar" class="btn-primary">Colaborar</a>
        <a href="#que-hacemos" class="btn-secondary">Conocer la propuesta</a>
      </div>
    </div>
  </section>

  <!-- QUIÉNES SOMOS -->
  <section class="about" id="quienes-somos">
    <div class="about__left">
      <img src="/assets/southamerica.svg" alt="Mapa de Sudamérica" class="about__map" />
      <div class="about__text">
        <p class="accent">Quiénes somos</p>
        <h2>Una escuela que camina con su comunidad</h2>
        <p>No somos una ONG ni una fundación: somos una propuesta educativa laica, gratuita y solidaria.</p>
      </div>
    </div>
    <div class="about__founder">
      <div class="founder__photo">
        <img src="/assets/wall-bg.png" alt="" aria-hidden="true" class="founder__wall" />
        <img src="/assets/julio-photo.png" alt="Julio Manuel Pereyra" class="founder__face" />
      </div>
      <div class="founder__info">
        <h3>Julio Manuel Pereyra</h3>
        <p class="founder__role">Docente, maestro y fundador</p>
        <p>Con una trayectoria dedicada a la educación inclusiva, su enfoque se centra en la escucha activa y el acompañamiento integral de las comunidades más vulnerables rompiendo barreras geográficas y sociales.</p>
      </div>
    </div>
  </section>

  <!-- QUÉ HACEMOS -->
  <section class="services" id="que-hacemos">
    <div class="services__header">
      <p class="accent">Qué hacemos</p>
      <h2>Educación integral, libre y cercana</h2>
    </div>
    <div class="services__grid">
      <article class="service-card">
        <div class="service-card__content">
          <img src="/assets/icon-literacy.svg" alt="" aria-hidden="true" width="24" height="24" />
          <h3>Alfabetización</h3>
          <p>Enseñamos a leer y escribir donde el sistema no llega.</p>
        </div>
        <div class="service-card__image">
          <img src="/assets/img-literacy.png" alt="Clase de alfabetización" />
        </div>
      </article>
      <article class="service-card service-card--reverse">
        <div class="service-card__image">
          <img src="/assets/img-school.png" alt="Apoyo escolar" />
        </div>
        <div class="service-card__content">
          <img src="/assets/icon-school.svg" alt="" aria-hidden="true" width="24" height="24" />
          <h3>Apoyo escolar</h3>
          <p>Acompañamos trayectorias educativas con refuerzo personalizado.</p>
        </div>
      </article>
      <article class="service-card">
        <div class="service-card__content">
          <img src="/assets/icon-stimulation.svg" alt="" aria-hidden="true" width="24" height="24" />
          <h3>Estimulación temprana</h3>
          <p>Talleres para el desarrollo integral de la primera infancia.</p>
        </div>
        <div class="service-card__image">
          <img src="/assets/img-stimulation.png" alt="Estimulación temprana" />
        </div>
      </article>
      <article class="service-card service-card--reverse">
        <div class="service-card__image">
          <img src="/assets/img-solidarity.png" alt="Redes solidarias" />
        </div>
        <div class="service-card__content">
          <img src="/assets/icon-solidarity.svg" alt="" aria-hidden="true" width="24" height="24" />
          <h3>Redes solidarias</h3>
          <p>Coordinamos donaciones de útiles, libros y recursos para las comunidades.</p>
        </div>
      </article>
    </div>
    <div class="differentiator">
      <p class="accent" style="color: white;">lo que nos hace únicos</p>
      <p>La única propuesta educativa comunitaria e itinerante para niños con discapacidad en contextos interculturales y rurales.</p>
    </div>
  </section>

  <!-- CON QUIÉNES TRABAJAMOS -->
  <section class="community" id="con-quienes">
    <h2>Con quiénes trabajamos</h2>
    <div class="community__grid">
      <div class="community__card">
        <h3>Comunidades originarias</h3>
        <p>Aldeas guaraníes en la selva misionera, en contextos interculturales y bilingües.</p>
      </div>
      <div class="community__card">
        <h3>Barrios y basurales</h3>
        <p>Niños y familias en barrios marginales y zonas de basurales.</p>
      </div>
      <div class="community__card">
        <h3>Chicos con discapacidad</h3>
        <p>Atención domiciliaria y hospitalaria para quienes no tienen cobertura.</p>
      </div>
      <div class="community__card">
        <h3>Escuelas públicas</h3>
        <p>Docentes y equipos que reciben talleres gratuitos de inclusión.</p>
      </div>
    </div>

    <div class="territories">
      <p class="label">TERRITORIOS RECORRIDOS</p>
      <div class="territories__tags">
        <span class="tag">Misiones</span>
        <span class="tag">Corrientes</span>
        <span class="tag">Río Negro</span>
        <span class="tag">Santiago del Estero</span>
        <span class="tag">Chaco</span>
        <span class="tag">Paraguay</span>
      </div>
    </div>

    <hr class="divider" />

    <div class="team">
      <p class="label">QUIÉNES LO HACEN POSIBLE</p>
      <div class="team__people">
        <div class="person-card">
          <div class="person-card__avatar">
            <img src="/assets/julio-photo.png" alt="Julio Manuel Pereyra" />
          </div>
          <div>
            <p class="person-card__name">Julio Manuel Pereyra</p>
            <p class="person-card__role">Fundador · educador comunitario</p>
          </div>
        </div>
        <div class="person-card">
          <div class="person-card__avatar">
            <img src="/assets/yanina-photo.png" alt="Yanina Rossi" />
          </div>
          <div>
            <p class="person-card__name">Yanina Rossi</p>
            <p class="person-card__role">Educadora comunitaria</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPACTO -->
  <section class="impact" id="impacto">
    <h2 class="impact__title">Impacto</h2>
    <div class="impact__divider" aria-hidden="true"></div>
    <div class="impact__stats">
      <div class="stat">
        <p class="stat__number accent" style="color: white;">+150</p>
        <p class="stat__desc">personas alfabetizadas<br/><span>100 niños y 50 adultos</span></p>
      </div>
      <div class="stat">
        <p class="stat__number accent" style="color: white;">+300</p>
        <p class="stat__desc">kits educativos<br/><span>mochilas y útiles entregados</span></p>
      </div>
      <div class="stat">
        <p class="stat__number accent" style="color: white;">+40</p>
        <p class="stat__desc">voluntarios formados<br/><span>como educadores comunitarios</span></p>
      </div>
      <div class="stat">
        <p class="stat__number accent" style="color: white;">900+</p>
        <p class="stat__desc">niños y adolescentes acompañados</p>
      </div>
      <div class="stat">
        <p class="stat__number accent" style="color: white;">100%</p>
        <p class="stat__desc">talleres y apoyo gratuitos</p>
      </div>
    </div>
  </section>

  <!-- COLABORAR -->
  <section class="contact" id="colaborar">
    <div class="contact__donation">
      <div>
        <h2>Colaborar</h2>
        <p>Tus donaciones nos permiten sostener la misión de la escuela y brindar la educación que los niños merecen.</p>
        <a href="https://www.mercadopago.com.ar" class="btn-primary" target="_blank" rel="noopener">
          <img src="/assets/icon-mercadopago.svg" alt="" width="24" height="24" />
          Donar con Mercado Pago
        </a>
        <p class="transfer-info">
          o hacernos una transferencia bancaria a <strong>ProfeJulioPereyra</strong>
        </p>
      </div>
      <blockquote class="quote">
        <p class="accent">"Donde hay una escuela, hay esperanza."</p>
        <cite>— Julio Manuel Pereyra</cite>
      </blockquote>
    </div>

    <div class="contact__form-wrapper">
      <h3>También podés contactarnos.</h3>
      <form
        class="contact-form"
        action="https://formspree.io/f/REEMPLAZAR_ID"
        method="POST"
      >
        <div class="form-row">
          <label class="field">
            <span>Nombre</span>
            <input type="text" name="nombre" placeholder="Tu nombre" required />
          </label>
          <label class="field">
            <span>Organización</span>
            <input type="text" name="organizacion" placeholder="Nombre de tu organización" />
          </label>
        </div>
        <label class="field">
          <span>Correo electrónico</span>
          <input type="email" name="email" placeholder="correo@organizacion.com" required />
        </label>
        <label class="field">
          <span>Mensaje</span>
          <textarea name="mensaje" placeholder="¿Cómo podemos colaborar juntos?" rows="5" required></textarea>
        </label>
        <button type="submit" class="btn-primary">Enviar mensaje</button>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <a href="/" aria-label="Caminos de Tiza">
      <img src="/assets/logo-light.svg" alt="Caminos de Tiza" height="35" />
    </a>
    <p>© 2026 Caminos de Tiza | escuelitas ambulantes</p>
    <div class="footer__social">
      <a href="#" aria-label="Facebook"><img src="/assets/sm-facebook.svg" alt="" width="24" height="24" /></a>
      <a href="#" aria-label="Instagram"><img src="/assets/sm-instagram.svg" alt="" width="24" height="24" /></a>
      <a href="#" aria-label="TikTok"><img src="/assets/sm-tiktok.svg" alt="" width="24" height="24" /></a>
      <a href="#" aria-label="X"><img src="/assets/sm-x.svg" alt="" width="24" height="24" /></a>
      <a href="#" aria-label="YouTube"><img src="/assets/sm-youtube.svg" alt="" width="24" height="24" /></a>
    </div>
  </footer>

</body>
</html>

<style>
/* NAV */
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px var(--margin);
  box-shadow: 0 12px 16px rgba(22,15,13,0.12);
}
.nav__logo img { height: 42px; width: auto; }
.nav__links { display: flex; align-items: center; gap: 4px; }
.nav__links a {
  padding: 8px 14px;
  border-radius: var(--radius);
  font-weight: 500;
  font-size: var(--body-s);
  color: var(--brand);
  transition: background 0.15s;
}
.nav__links a:hover { background: var(--brand-subtle); }
.nav__links .btn-nav {
  background: var(--brand);
  color: var(--text-inverse);
  border: 2px solid var(--brand);
}
.nav__links .btn-nav:hover { background: var(--brand-hover); border-color: var(--brand-hover); }
.nav__burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 8px; }
.nav__burger span { display: block; width: 24px; height: 2px; background: var(--brand); border-radius: 2px; }

.mobile-menu {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 16px var(--margin);
  background: var(--surface);
  border-bottom: 1px solid var(--surface-bold);
}
.mobile-menu a { padding: 10px 14px; color: var(--brand); font-weight: 500; border-radius: var(--radius); }

/* HERO */
.hero {
  position: relative;
  background: var(--surface-bold);
  padding: 80px var(--margin);
  min-height: 520px;
  overflow: hidden;
}
.hero__bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  mix-blend-mode: overlay;
  opacity: 0.3;
}
.hero__content {
  position: relative;
  max-width: 640px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.hero h1 { font-size: var(--h1); font-weight: 500; line-height: 1.1; }
.hero__body { font-size: var(--body-l); line-height: 1.6; }
.hero__actions { display: flex; flex-wrap: wrap; gap: 8px 16px; }

/* ABOUT */
.about { display: flex; flex-wrap: wrap; align-items: stretch; }
.about__left {
  background: var(--surface);
  display: flex;
  align-items: center;
  gap: 44px;
  flex: 1 0 360px;
  padding: 80px 40px 80px var(--margin);
  min-height: 512px;
}
.about__map { width: 162px; height: auto; flex-shrink: 0; }
.about__text { display: flex; flex-direction: column; gap: 24px; }
.about__text h2 { font-size: var(--h2); font-weight: 500; line-height: 1.15; }

.about__founder {
  background: var(--surface-bolder);
  display: flex;
  flex-direction: column;
  gap: 24px;
  justify-content: center;
  flex: 0 0 480px;
  padding: 40px var(--margin) 40px 40px;
  min-height: 512px;
}
.founder__photo {
  position: relative;
  width: 144px;
  height: 144px;
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(to bottom, var(--brand), var(--brand-hover));
  flex-shrink: 0;
}
.founder__wall {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.4;
}
.founder__face {
  position: absolute;
  bottom: 0;
  left: 5px;
  width: 134px;
  height: auto;
  object-fit: cover;
}
.founder__info { display: flex; flex-direction: column; gap: 8px; }
.founder__info h3 { font-size: var(--h6); font-weight: 500; line-height: 1.35; }
.founder__role { color: var(--brand); font-weight: 500; }

/* SERVICES */
.services {
  background: var(--surface-bold);
  padding: 80px var(--margin);
  display: flex;
  flex-direction: column;
  gap: 48px;
}
.services__header { display: flex; flex-direction: column; gap: 16px; }
.services__header h2 { font-size: var(--h2); font-weight: 500; line-height: 1.15; }
.services__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.service-card {
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 12px 16px rgba(22,15,13,0.12);
}
.service-card--reverse { flex-direction: column-reverse; }
.service-card__content {
  background: var(--surface);
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
  min-height: 265px;
}
.service-card__content h3 { font-size: var(--body-l); font-weight: 500; line-height: 1.6; }
.service-card__image { height: 218px; overflow: hidden; background: var(--brand-subtle); }
.service-card__image img { width: 100%; height: 100%; object-fit: cover; }
.differentiator {
  background: var(--brand);
  color: var(--text-inverse);
  border-radius: 12px;
  padding: 32px;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}
.differentiator p:last-child { font-size: var(--body-s); line-height: 1.6; }

/* COMMUNITY */
.community {
  background: var(--surface);
  padding: 64px var(--margin);
  display: flex;
  flex-direction: column;
  gap: 48px;
}
.community h2 { font-size: var(--h2); font-weight: 500; line-height: 1.15; }
.community__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.community__card {
  background: var(--surface-bold);
  border-radius: 14px;
  padding: 20px;
  min-height: 143px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.community__card h3 { font-size: var(--body-m); font-weight: 500; line-height: 1.7; }
.community__card p { font-size: var(--body-s); color: var(--text-subtle); line-height: 1.6; }

.label { font-size: var(--body-xs); font-weight: 500; color: var(--text-subtle); letter-spacing: 0.05em; }
.territories { display: flex; flex-direction: column; gap: 14px; }
.territories__tags { display: flex; flex-wrap: wrap; gap: 8px; }
.tag {
  background: var(--surface-bold);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 6px 14px;
  font-size: var(--body-s);
}
.divider { border: none; border-top: 1px solid var(--border); }
.team { display: flex; flex-direction: column; gap: 20px; }
.team__people { display: flex; flex-wrap: wrap; gap: 16px; }
.person-card {
  background: var(--surface-bold);
  border-radius: 14px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1 0 300px;
}
.person-card__avatar { width: 44px; height: 44px; border-radius: 22px; overflow: hidden; background: var(--brand); flex-shrink: 0; }
.person-card__avatar img { width: 100%; height: 100%; object-fit: cover; }
.person-card__name { font-size: var(--body-s); font-weight: 500; color: var(--text); }
.person-card__role { font-size: var(--body-xs); color: var(--text-subtle); }

/* IMPACT */
.impact {
  background: var(--brand);
  color: var(--text-inverse);
  padding: 40px var(--margin);
  display: flex;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
}
.impact__title { font-size: var(--h2); font-weight: 500; line-height: 1.15; white-space: nowrap; }
.impact__divider { width: 1px; height: 100px; background: rgba(255,255,255,0.4); flex-shrink: 0; }
.impact__stats { display: flex; flex: 1; gap: 24px; flex-wrap: wrap; }
.stat { flex: 1 0 100px; display: flex; flex-direction: column; gap: 4px; text-align: center; }
.stat__number { font-size: var(--accent); line-height: 1.3; }
.stat__desc { font-size: var(--body-s); line-height: 1.6; opacity: 0.92; }
.stat__desc span { display: block; }

/* CONTACT */
.contact {
  background: var(--surface-bold);
  padding: 80px var(--margin);
  display: flex;
  flex-wrap: wrap;
  gap: 48px;
  align-items: flex-start;
}
.contact__donation { flex: 1 0 300px; display: flex; flex-direction: column; gap: 60px; }
.contact__donation > div { display: flex; flex-direction: column; gap: 16px; }
.contact__donation h2 { font-size: var(--h2); font-weight: 500; line-height: 1.15; }
.transfer-info { font-size: var(--body-m); line-height: 1.7; }
.quote { display: flex; flex-direction: column; gap: 8px; }
.quote cite { font-size: var(--body-s); color: var(--text-subtle); font-style: normal; }

.contact__form-wrapper {
  flex: 1 0 300px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}
.contact__form-wrapper h3 { font-size: var(--h6); font-weight: 500; line-height: 1.35; }
.contact-form { display: flex; flex-direction: column; gap: 20px; }
.form-row { display: flex; flex-wrap: wrap; gap: 20px; }
.field { display: flex; flex-direction: column; gap: 8px; flex: 1 0 200px; }
.field span { font-size: var(--body-s); font-weight: 500; color: var(--text); }
.field input, .field textarea {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 11px 14px;
  font-family: 'Work Sans', sans-serif;
  font-size: var(--body-m);
  color: var(--text);
  width: 100%;
  transition: border-color 0.2s;
}
.field input::placeholder, .field textarea::placeholder { color: var(--text-subtle); }
.field input:focus, .field textarea:focus { outline: none; border-color: var(--brand); }
.field textarea { resize: vertical; }
.contact-form .btn-primary { align-self: flex-start; }

/* FOOTER */
.footer {
  background: var(--brand);
  color: var(--text-inverse);
  padding: 40px var(--margin);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}
.footer p { font-size: var(--body-s); opacity: 0.92; }
.footer__social { display: flex; gap: 4px; }
.footer__social a { padding: 8px 14px; border-radius: var(--radius); transition: background 0.15s; }
.footer__social a:hover { background: rgba(255,255,255,0.1); }

/* RESPONSIVE */
@media (max-width: 1024px) {
  .services__grid { grid-template-columns: repeat(2, 1fr); }
  .community__grid { grid-template-columns: repeat(2, 1fr); }
  .about__founder { flex: 1 0 300px; }
}

@media (max-width: 768px) {
  .nav__links { display: none; }
  .nav__burger { display: flex; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu:not([hidden]) { display: flex; }
  .about { flex-direction: column; }
  .about__left { padding: 48px var(--margin); min-height: unset; flex-wrap: wrap; }
  .about__founder { flex: 1 0 100%; padding: 48px var(--margin); min-height: unset; }
  .services__grid { grid-template-columns: 1fr; }
  .community__grid { grid-template-columns: 1fr; }
  .impact { flex-direction: column; align-items: flex-start; gap: 24px; }
  .impact__divider { display: none; }
  .impact__stats { flex-direction: column; gap: 16px; }
  .stat { text-align: left; }
  .footer { flex-direction: column; align-items: flex-start; }
}
</style>

<script>
  const burger = document.querySelector('.nav__burger') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLDivElement;
  burger?.addEventListener('click', () => {
    const isOpen = !menu.hasAttribute('hidden');
    if (isOpen) {
      menu.setAttribute('hidden', '');
      burger.setAttribute('aria-expanded', 'false');
    } else {
      menu.removeAttribute('hidden');
      burger.setAttribute('aria-expanded', 'true');
    }
  });
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu.setAttribute('hidden', '');
      burger.setAttribute('aria-expanded', 'false');
    });
  });
</script>
