---
import '../styles/global.css';
import TextField from '../components/TextField.astro';
import Button from '../components/Button.astro';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Caminos de Tiza – Educación comunitaria, gratuita y solidaria</title>
  <meta name="description" content="Trabajamos junto a niños, adolescentes y familias en situaciones de vulnerabilidad en Argentina, llevando educación, inclusión y dignidad a quienes más lo necesitan." />
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
</head>

<body>

  <!-- NAV -->
  <header class="nav">
    <a href="/" class="nav__logo" aria-label="Caminos de Tiza">
      <img src="/assets/logo.svg" alt="Caminos de Tiza" height="42" />
    </a>
    <nav class="nav__links" aria-label="Navegación principal">
      <a href="#quienes-somos">Quiénes somos</a>
      <a href="#que-hacemos">Qué hacemos</a>
      <a href="#con-quienes">Con quiénes trabajamos</a>
      <a href="#impacto">Impacto</a>
      <Button href="#colaborar" variant="nav">Colaborar</Button>
    </nav>
    <button class="nav__burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <div id="mobile-menu" class="mobile-menu" hidden aria-modal="true" role="dialog" aria-label="Menú de navegación">
    <div class="mobile-menu__header">
      <a href="/" class="nav__logo" aria-label="Caminos de Tiza">
        <img src="/assets/logo.svg" alt="Caminos de Tiza" height="42" />
      </a>
      <button class="mobile-menu__close" aria-label="Cerrar menú">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <nav class="mobile-menu__links">
      <a href="#quienes-somos">Quiénes somos</a>
      <a href="#que-hacemos">Qué hacemos</a>
      <a href="#con-quienes">A quiénes llegamos</a>
      <a href="#impacto">Impacto</a>
    </nav>
    <div class="mobile-menu__footer">
      <Button href="#colaborar" variant="primary">Colaborar</Button>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero" id="inicio">
    <div class="hero__bg" aria-hidden="true">
      <img src="/assets/hero-bg.png" alt="" />
    </div>
    <div class="hero__content">
      <p class="accent">Educación comunitaria, gratuita y solidaria</p>
      <h1>Caminos que transforman vidas</h1>
      <p class="hero__body">Trabajamos junto a niños, adolescentes y familias en situaciones de vulnerabilidad en Argentina, llevando educación, inclusión y dignidad a quienes más lo necesitan.</p>
      <div class="hero__actions">
        <Button href="#colaborar" variant="primary">Colaborar</Button>
        <Button href="#que-hacemos" variant="secondary">Conocer la propuesta</Button>
      </div>
    </div>
  </section>

  <!-- QUIÉNES SOMOS -->
  <section class="about" id="quienes-somos">
    <div class="about__left">
      <img src="/assets/southamerica.svg" alt="Mapa de Sudamérica" class="about__map" />
      <div class="about__text">
        <p class="accent">Quiénes somos</p>
        <h2>Una escuela que camina con su comunidad</h2>
        <p>No somos una ONG ni una fundación: somos una propuesta educativa laica, gratuita y solidaria.</p>
      </div>
    </div>
    <div class="about__founder">
      <div class="founder__photo">
        <img src="/assets/wall-bg.png" alt="" aria-hidden="true" class="founder__wall" />
        <img src="/assets/julio-photo.png" alt="Julio Manuel Pereyra" class="founder__face" />
      </div>
      <div class="founder__info">
        <h3>Julio Manuel Pereyra</h3>
        <p class="founder__role">Docente, maestro y fundador</p>
        <p>Con una trayectoria dedicada a la educación inclusiva, su enfoque se centra en la escucha activa y el acompañamiento integral de las comunidades más vulnerables rompiendo barreras geográficas y sociales.</p>
      </div>
    </div>
  </section>

  <!-- QUÉ HACEMOS -->
  <section class="services" id="que-hacemos">
    <div class="services__header">
      <p class="accent">Qué hacemos</p>
      <h2>Educación integral, libre y cercana</h2>
    </div>
    <div class="services__grid">
      <article class="service-card">
        <div class="service-card__content">
          <img src="/assets/icon-literacy.svg" alt="" aria-hidden="true" width="24" height="24" />
          <h3>Alfabetización</h3>
          <p>Enseñamos a leer y escribir donde el sistema no llega.</p>
        </div>
        <div class="service-card__image">
          <img src="/assets/img-literacy.png" alt="Clase de alfabetización" />
        </div>
      </article>
      <article class="service-card service-card--reverse">
        <div class="service-card__image">
          <img src="/assets/img-school.png" alt="Apoyo escolar" />
        </div>
        <div class="service-card__content">
          <img src="/assets/icon-school.svg" alt="" aria-hidden="true" width="24" height="24" />
          <h3>Apoyo escolar</h3>
          <p>Acompañamos trayectorias educativas con refuerzo personalizado.</p>
        </div>
      </article>
      <article class="service-card">
        <div class="service-card__content">
          <img src="/assets/icon-stimulation.svg" alt="" aria-hidden="true" width="24" height="24" />
          <h3>Estimulación temprana</h3>
          <p>Talleres para el desarrollo integral de la primera infancia.</p>
        </div>
        <div class="service-card__image">
          <img src="/assets/img-stimulation.png" alt="Estimulación temprana" />
        </div>
      </article>
      <article class="service-card service-card--reverse">
        <div class="service-card__image">
          <img src="/assets/img-solidarity.png" alt="Redes solidarias" />
        </div>
        <div class="service-card__content">
          <img src="/assets/icon-solidarity.svg" alt="" aria-hidden="true" width="24" height="24" />
          <h3>Redes solidarias</h3>
          <p>Coordinamos donaciones de útiles, libros y recursos para las comunidades.</p>
        </div>
      </article>
    </div>
    <div class="differentiator">
      <p class="accent" style="color: white;">lo que nos hace únicos</p>
      <p>La única propuesta educativa comunitaria e itinerante para niños con discapacidad en contextos interculturales y rurales.</p>
    </div>
  </section>

  <!-- CON QUIÉNES TRABAJAMOS -->
  <section class="community" id="con-quienes">
    <h2>Con quiénes trabajamos</h2>
    <div class="community__grid">
      <div class="community__card">
        <h3>Comunidades originarias</h3>
        <p>Aldeas guaraníes en la selva misionera, en contextos interculturales y bilingües.</p>
      </div>
      <div class="community__card">
        <h3>Barrios y basurales</h3>
        <p>Niños y familias en barrios marginales y zonas de basurales.</p>
      </div>
      <div class="community__card">
        <h3>Chicos con discapacidad</h3>
        <p>Atención domiciliaria y hospitalaria para quienes no tienen cobertura.</p>
      </div>
      <div class="community__card">
        <h3>Escuelas públicas</h3>
        <p>Docentes y equipos que reciben talleres gratuitos de inclusión.</p>
      </div>
    </div>

    <div class="territories">
      <p class="label">TERRITORIOS RECORRIDOS</p>
      <div class="territories__tags">
        <span class="tag">Misiones</span>
        <span class="tag">Corrientes</span>
        <span class="tag">Río Negro</span>
        <span class="tag">Santiago del Estero</span>
        <span class="tag">Chaco</span>
        <span class="tag">Paraguay</span>
      </div>
    </div>

    <hr class="divider" />

    <div class="team">
      <p class="label">QUIÉNES LO HACEN POSIBLE</p>
      <div class="team__people">
        <div class="person-card">
          <div class="person-card__avatar">
            <img src="/assets/julio-photo.png" alt="Julio Manuel Pereyra" />
          </div>
          <div>
            <p class="person-card__name">Julio Manuel Pereyra</p>
            <p class="person-card__role">Fundador · educador comunitario</p>
          </div>
        </div>
        <div class="person-card">
          <div class="person-card__avatar">
            <img src="/assets/yanina-photo.png" alt="Yanina Rossi" />
          </div>
          <div>
            <p class="person-card__name">Yanina Rossi</p>
            <p class="person-card__role">Educadora comunitaria</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPACTO -->
  <section class="impact" id="impacto">
    <h2 class="impact__title">Impacto</h2>
    <div class="impact__divider" aria-hidden="true"></div>
    <div class="impact__stats">
      <div class="stat">
        <p class="stat__number accent" style="color: white;">+150</p>
        <p class="stat__desc">personas alfabetizadas<br/><span>100 niños y 50 adultos</span></p>
      </div>
      <div class="stat">
        <p class="stat__number accent" style="color: white;">+300</p>
        <p class="stat__desc">kits educativos<br/><span>mochilas y útiles entregados</span></p>
      </div>
      <div class="stat">
        <p class="stat__number accent" style="color: white;">+40</p>
        <p class="stat__desc">voluntarios formados<br/><span>como educadores comunitarios</span></p>
      </div>
      <div class="stat">
        <p class="stat__number accent" style="color: white;">900+</p>
        <p class="stat__desc">niños y adolescentes acompañados</p>
      </div>
      <div class="stat">
        <p class="stat__number accent" style="color: white;">100%</p>
        <p class="stat__desc">talleres y apoyo gratuitos</p>
      </div>
    </div>
  </section>

  <!-- COLABORAR -->
  <section class="contact" id="colaborar">
    <div class="contact__donation">
      <div>
        <h2>Colaborar</h2>
        <p>Tus donaciones nos permiten sostener la misión de la escuela y brindar la educación que los niños merecen.</p>
        <Button href="https://www.mercadopago.com.ar" variant="primary" class="btn-mp" target="_blank" rel="noopener">
          <img src="/assets/icon-mercadopago.svg" alt="" class="mp-icon" />
          Donar con Mercado Pago
        </Button>
        <p class="transfer-info">
          o hacernos una transferencia bancaria a <strong>ProfeJulioPereyra</strong>
          <button class="btn-copy" aria-label="Copiar alias" title="Copiar alias">
            <img src="/assets/icon-solidarity.svg" alt="" width="16" height="16" style="display:none" />
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
          <span class="copy-feedback" hidden>¡Copiado!</span>
        </p>
      </div>
      <blockquote class="quote">
        <p class="accent">"Donde hay una escuela, hay esperanza."</p>
        <cite>— Julio Manuel Pereyra</cite>
      </blockquote>
    </div>

    <div class="contact__form-wrapper">
      <h3>También podés contactarnos.</h3>
      <form
        class="contact-form"
        action="https://formspree.io/f/REEMPLAZAR_ID"
        method="POST"
        novalidate
      >
        <div class="form-row">
          <TextField label="Nombre" name="nombre" placeholder="Tu nombre" required noOnlyNumbers />
          <TextField label="Organización" name="organizacion" placeholder="Nombre de tu organización" noOnlyNumbers />
        </div>
        <TextField label="Correo electrónico" name="email" type="email" placeholder="correo@organizacion.com" required />
        <TextField label="Mensaje" name="mensaje" textarea rows={5} required />
        <Button type="submit" class="form-submit">Enviar mensaje</Button>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <a href="/" aria-label="Caminos de Tiza">
      <img src="/assets/logo-light.svg" alt="Caminos de Tiza" height="35" />
    </a>
    <p>© 2026 Caminos de Tiza | escuelitas ambulantes</p>
    <div class="footer__social">
      <a href="#" aria-label="Facebook"><img src="/assets/sm-facebook.svg" alt="" width="24" height="24" /></a>
      <a href="#" aria-label="Instagram"><img src="/assets/sm-instagram.svg" alt="" width="24" height="24" /></a>
      <a href="#" aria-label="TikTok"><img src="/assets/sm-tiktok.svg" alt="" width="24" height="24" /></a>
      <a href="#" aria-label="X"><img src="/assets/sm-x.svg" alt="" width="24" height="24" /></a>
      <a href="#" aria-label="YouTube"><img src="/assets/sm-youtube.svg" alt="" width="24" height="24" /></a>
    </div>
  </footer>

</body>
</html>

<style>
/* NAV */
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg-surface-default);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px var(--margin);
  box-shadow: var(--shadow-lg);
}
.nav__logo img { height: 42px; width: auto; }
.nav__links { display: flex; align-items: center; gap: var(--space-1); }
.nav__links a {
  padding: 8px 14px;
  border-radius: var(--radius-md);
  font-weight: var(--font-weight-medium);
  font-size: var(--font-body-s-size);
  color: var(--fg-brand);
  transition: background 0.15s;
}
.nav__links a:hover { background: var(--bg-brand-subtle); }
.nav__burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: var(--space-2); }
.nav__burger span { display: block; width: 24px; height: 2px; background: var(--bg-brand-bold); border-radius: 2px; }

.mobile-menu {
  display: none;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 120px;
  right: 0;
  bottom: 0;
  background: var(--bg-surface-default);
  z-index: 999;
  box-shadow: -4px 0 40px rgba(22, 15, 13, 0.14);
  overflow-y: auto;
}
.mobile-menu__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px var(--space-6);
  border-bottom: 1px solid var(--bg-surface-bold);
  min-height: 70px;
}
.mobile-menu__close {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--fg-brand);
  padding: var(--space-2);
  display: flex;
  align-items: center;
  border-radius: var(--radius-md);
  transition: background 0.15s;
}
.mobile-menu__close:hover { background: var(--bg-brand-subtle); }
.mobile-menu__links {
  display: flex;
  flex-direction: column;
  padding: var(--space-6);
  gap: var(--space-2);
  flex: 1;
}
.mobile-menu__links a {
  padding: var(--space-4) var(--space-2);
  color: var(--fg-brand);
  font-weight: var(--font-weight-medium);
  font-size: var(--font-title-s-size);
  border-radius: var(--radius-md);
  transition: background 0.15s;
}
.mobile-menu__links a:hover { background: var(--bg-brand-subtle); }
.mobile-menu__footer {
  padding: var(--space-6);
  border-top: 1px solid var(--bg-surface-bold);
}
:global(.mobile-menu__footer > a, .mobile-menu__footer > button) { width: 100%; justify-content: center; }

/* HERO */
.hero {
  position: relative;
  background: var(--bg-surface-bold);
  padding: var(--space-20) var(--margin);
  min-height: 520px;
  overflow: hidden;
}
.hero__bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  mix-blend-mode: overlay;
  opacity: 0.95;
}
.hero__content {
  position: relative;
  max-width: 640px;
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}
.hero h1 { font-size: var(--font-title-xxl-size); font-weight: var(--font-weight-medium); line-height: 1.1; }
.hero__body { font-size: var(--font-body-l-size); line-height: 1.6; }
.hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }

/* ABOUT */
.about { display: flex; flex-wrap: wrap; align-items: stretch; }
.about__left {
  background: var(--bg-surface-default);
  display: flex;
  align-items: center;
  gap: 44px;
  flex: 1 0 360px;
  padding: var(--space-20) var(--space-10) var(--space-20) var(--margin);
  min-height: 512px;
}
.about__map { width: 162px; height: auto; flex-shrink: 0; }
.about__text { display: flex; flex-direction: column; gap: var(--space-6); }
.about__text h2 { font-size: var(--font-title-xl-size); font-weight: var(--font-weight-medium); line-height: 1.15; }

.about__founder {
  background: var(--bg-surface-bolder);
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  justify-content: center;
  flex: 0 0 480px;
  padding: var(--space-10) var(--margin) var(--space-10) var(--space-10);
  min-height: 512px;
}
.founder__photo {
  position: relative;
  width: 144px;
  height: 144px;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: linear-gradient(to bottom, var(--bg-brand-bold), var(--bg-brand-bold-hover));
  flex-shrink: 0;
}
.founder__wall {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.4;
}
.founder__face {
  position: absolute;
  bottom: 0;
  left: 5px;
  width: 134px;
  height: auto;
  object-fit: cover;
}
.founder__info { display: flex; flex-direction: column; gap: var(--space-2); }
.founder__info h3 { font-size: var(--font-title-xs-size); font-weight: var(--font-weight-medium); line-height: 1.35; }
.founder__role { color: var(--fg-brand); font-weight: var(--font-weight-medium); }

/* SERVICES */
.services {
  background: var(--bg-surface-bold);
  padding: var(--space-20) var(--margin);
  display: flex;
  flex-direction: column;
  gap: var(--space-12);
}
.services__header { display: flex; flex-direction: column; gap: var(--space-4); }
.services__header h2 { font-size: var(--font-title-xl-size); font-weight: var(--font-weight-medium); line-height: 1.15; }
.services__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
.service-card {
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}
.service-card--reverse { flex-direction: column-reverse; }
.service-card__content {
  background: var(--bg-surface-default);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  flex: 1;
  min-height: 265px;
}
.service-card__content h3 { font-size: var(--font-body-l-size); font-weight: var(--font-weight-medium); line-height: 1.6; }
.service-card__image { height: 218px; overflow: hidden; background: var(--bg-brand-subtle); position: relative; }
.service-card__image img { width: 100%; height: 100%; object-fit: cover; }
.service-card__image::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(191, 140, 89, 0.7);
  mix-blend-mode: multiply;
}
.differentiator {
  background: var(--bg-brand-bold);
  color: var(--fg-inverse);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  box-shadow: var(--shadow-sm);
}
.differentiator p:last-child { font-size: var(--font-body-s-size); line-height: 1.6; }

/* COMMUNITY */
.community {
  background: var(--bg-surface-default);
  padding: var(--space-16) var(--margin);
  display: flex;
  flex-direction: column;
  gap: var(--space-12);
}
.community h2 { font-size: var(--font-title-xl-size); font-weight: var(--font-weight-medium); line-height: 1.15; }
.community__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
.community__card {
  background: var(--bg-surface-bold);
  border-radius: 14px;
  padding: var(--space-5);
  min-height: 143px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.community__card h3 { font-size: var(--font-body-m-size); font-weight: var(--font-weight-medium); line-height: 1.7; }
.community__card p { font-size: var(--font-body-s-size); color: var(--fg-neutral-subtle); line-height: 1.6; }

.label { font-size: var(--font-body-xs-size); font-weight: var(--font-weight-medium); color: var(--fg-neutral-subtle); letter-spacing: 0.05em; }
.territories { display: flex; flex-direction: column; gap: 14px; }
.territories__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.tag {
  background: var(--bg-surface-bold);
  border: 1px solid var(--border-neutral);
  border-radius: var(--radius-xl);
  padding: 6px 14px;
  font-size: var(--font-body-s-size);
}
.divider { border: none; border-top: 1px solid var(--border-neutral); }
.team { display: flex; flex-direction: column; gap: var(--space-5); }
.team__people { display: flex; flex-wrap: wrap; gap: var(--space-4); }
.person-card {
  background: var(--bg-surface-bold);
  border-radius: 14px;
  padding: var(--space-4);
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1 0 300px;
}
.person-card__avatar { width: 44px; height: 44px; border-radius: 22px; overflow: hidden; background: var(--bg-brand-bold); flex-shrink: 0; }
.person-card__avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
.person-card__name { font-size: var(--font-body-s-size); font-weight: var(--font-weight-medium); color: var(--fg-neutral-default); }
.person-card__role { font-size: var(--font-body-xs-size); color: var(--fg-neutral-subtle); }

/* IMPACT */
.impact {
  background: var(--bg-brand-bold);
  color: var(--fg-inverse);
  padding: var(--space-10) var(--margin);
  display: flex;
  align-items: center;
  gap: var(--space-10);
  flex-wrap: wrap;
}
.impact__title { font-size: var(--font-title-xl-size); font-weight: var(--font-weight-medium); line-height: 1.15; white-space: nowrap; }
